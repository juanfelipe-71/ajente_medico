# Variables de entorno para Agente Médico
# Copia este archivo como .env y completa las claves API

# API Key de Google Gemini AI
# Obtén tu clave en: https://ai.google.dev/
GEMINI_API_KEY=tu_clave_aqui

# API Key de Tavily Search
# Obtén tu clave en: https://tavily.com/
TAVILY_API_KEY=tu_clave_aqui

# Configuración de la aplicación (opcional)
APP_TITLE=Agente Médico - Diagnóstico y Recomendaciones
APP_DESCRIPTION=Aplicación de diagnóstico médico preliminar con IA

# Configuración de búsqueda (opcional)
MAX_SEARCH_RESULTS=5
SEARCH_TIMEOUT=10

# Configuración de IA (opcional)
GEMINI_MODEL=gemini-2.0-flash-exp
MAX_TOKENS_DIAGNOSTICO=1000
MAX_TOKENS_MEDICAMENTOS=800